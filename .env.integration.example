# Optional Railway runtime flags. No automatic production migration.
GUESTRA_INTEGRATION_V2_ENABLED=false
GUESTRA_INBOX_ENABLED=false
GUESTRA_SANDBOX_SETUP_ENABLED=false
INTEGRATION_ENVIRONMENT=production
CONNECT_QUOTE_SIGNING_SECRET=
CONNECT_QUOTE_TTL_SECONDS=300
PMS_COMMAND_SECRET=
# Event HMAC uses the existing PMS webhook subscription secret.
# Target: /api/integrations/pms/v1/events/CRM_PROPERTY with that secret.
CRM_AGENT_URL=https://crm.example.com/api/integrations/agent
CRM_AGENT_KEY=
CRM_PROPERTY_MAPPINGS=[]
# [{"crmPropertyId":"...","crmTenantId":"...","pmsPropertyId":"UUID","pmsTenantId":"...","environment":"production"}]
# Property-scoped Connect capabilities: integration.read,integration.write,events.read,environment:production
# sandbox.setup is for a separate test/sandbox credential only.
# Build-time Dashboard flag, independent of backend runtime flag:
VITE_GUESTRA_INBOX_ENABLED=false
# Keep existing auth, database, Redis, payment and release configuration.
