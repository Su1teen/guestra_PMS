    "jsCode": "const e = $('Error Trigger').first().json;\nconst row = $input.first().json;\nconst msg = String(e.execution?.error?.message ?? '').toUpperCase();\nconst code = msg.includes('AGENT_EMPTY') ? 'AGENT_EMPTY_REPLY' : msg.includes('CRM_INBOUND') ? 'CRM_INBOUND_REJECTED' : 'WORKFLOW_EXECUTION_FAILED';\nif (!row || !row.runId) return [{ json: { skip: true, reason: 'run_not_claimed', executionId: e.execution?.id } }];\nreturn [{ json: { workspaceId: row.workspaceId, runId: row.runId, correlationId: row.correlationId, executionId: String(e.execution.id), sequence: 90, state: 'failed', errorCode: code, workflowVersion: 'aidana-agent-1.0.0', deploymentId: 'aidana-agent-1.0.0+6bad4cb02da0' } }];"
